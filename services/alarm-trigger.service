[Unit]
Description=Monty Alarm Clock Trigger
After=sound.target monty-alarm-api.service

[Service]
Type=simple
User=pi
Group=audio
SupplementaryGroups=gpio
WorkingDirectory=/home/pi/monty-alarm
ExecStart=/usr/bin/python3 -u /home/pi/monty-alarm/core/alarm_trigger.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
