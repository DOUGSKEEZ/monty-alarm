[Unit]
Description=Alarm Clock Button Lights
After=multi-user.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=plugdev
WorkingDirectory=/home/pi/monty-alarm
ExecStart=/usr/bin/python3 -u /home/pi/monty-alarm/core/button_leds.py watch
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
