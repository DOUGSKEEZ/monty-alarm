[Unit]
Description=Alarm Clock USB Button Handler
After=multi-user.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=input
WorkingDirectory=/home/pi/monty-alarm
ExecStart=/usr/bin/python3 -u /home/pi/monty-alarm/core/alarm_button_handler.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
